{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": ".vercel-out",
  "installCommand": "echo 'sem dependências na raiz — o painel instala as suas no build'",
  "redirects": [
    {
      "source": "/painel-ubs",
      "destination": "/medicacoes",
      "permanent": false
    },
    {
      "source": "/painel-ubs/:caminho*",
      "destination": "/medicacoes/:caminho*",
      "permanent": false
    }
  ]
}
