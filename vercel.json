{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-vercel.sh",
  "outputDirectory": ".vercel-out",
  "installCommand": "echo 'sem depend\u00eancias na raiz \u2014 o painel instala as suas no build'",
  "redirects": [
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "www.wmed.ai"
        }
      ],
      "destination": "https://wmed.ai/:caminho*",
      "permanent": true
    },
    {
      "source": "/care-whatsapp",
      "destination": "https://wa.me/5512996527434?text=Quero%20come%C3%A7ar%20o%20Vytal%20Care%20%5BIG-BIO-001%5D",
      "permanent": false
    },
    {
      "source": "/care-anuncio",
      "destination": "https://wa.me/5512996527434?text=Quero%20come%C3%A7ar%20o%20Vytal%20Care%20%5BMETA-ANUNCIO-001%5D",
      "permanent": false
    },
    {
      "source": "/care",
      "destination": "/vytal-care2?utm_source=ig&utm_medium=social&utm_campaign=care_familia_v1&utm_content=link_in_bio",
      "permanent": true
    },
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "www.mapadogoverno.com.br"
        }
      ],
      "destination": "https://mapadogoverno.com.br/:caminho*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mapadogoverno.com.br"
        }
      ],
      "destination": "/governo/",
      "permanent": false
    },
    {
      "source": "/painel-ubs",
      "destination": "/medicacoes",
      "permanent": false
    },
    {
      "source": "/painel-ubs/:caminho*",
      "destination": "/medicacoes/:caminho*",
      "permanent": false
    },
    {
      "source": "/vytal-medicacoes",
      "destination": "/vytal-care",
      "permanent": true
    },
    {
      "source": "/vytal-medicacoes/:caminho*",
      "destination": "/vytal-care/:caminho*",
      "permanent": true
    },
    {
      "source": "/wmed",
      "destination": "/wmed/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wmed.ai"
        }
      ],
      "destination": "/wmed/"
    },
    {
      "source": "/:caminho((?!wmed/|wmed$|api/).*)",
      "has": [
        {
          "type": "host",
          "value": "wmed.ai"
        }
      ],
      "destination": "/wmed/:caminho"
    },
    {
      "source": "/wmed/acervo/:path*",
      "destination": "https://app.vytalsaude.com.br/academico-assets/:path*"
    },
    {
      "source": "/:caminho*",
      "has": [
        {
          "type": "host",
          "value": "mapadogoverno.com.br"
        }
      ],
      "destination": "/governo/:caminho*"
    },
    {
      "source": "/vytal-care2/app/:path*",
      "destination": "/vytal-care2/app/index.html"
    }
  ],
  "functions": {
    "api/wmed/research.js": {
      "maxDuration": 30
    },
    "api/wmed/chat.js": {
      "maxDuration": 300
    },
    "api/wmed/auth.js": {
      "maxDuration": 30
    },
    "api/wmed/academic.js": {
      "maxDuration": 300
    },
    "api/wmed/cases.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/wmed/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
