{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Briefing de site de clínica ou consultório",
  "description": "Campos com prefixo _ são internos (prospecção, anotações) e nunca são renderizados nem validados.",
  "type": "object",
  "required": ["slug", "nome", "contato"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "vira a URL: /preview/<slug>/" },
    "tipo": { "enum": ["clinica", "consultorio", "odontologia", "fisioterapia", "psicologia", "nutricao", "estetica", "veterinaria"] },
    "conselho": {
      "enum": ["CFM", "CFO", "CFP", "CREFITO", "CRN", "CFMV", "NENHUM"],
      "default": "CFM",
      "description": "Define quais vedações se aplicam. Na dúvida, use o mais restritivo."
    },
    "nome": { "type": "string" },
    "descricao": { "type": "string", "description": "meta description, 140-160 caracteres" },
    "chamada": { "type": "string", "description": "H1 do hero; aceita <em> para destacar" },
    "subchamada": { "type": "string" },
    "hero": { "type": "object", "properties": { "selo": { "type": "string" } } },
    "responsavel": { "$ref": "#/definitions/profissional" },
    "equipe": { "type": "array", "items": { "$ref": "#/definitions/profissional" } },
    "especialidades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome"],
        "properties": {
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "icone": { "enum": ["coracao", "estetoscopio", "dente", "crianca", "olho", "osso", "cerebro", "pele", "exame", "padrao"] }
        }
      }
    },
    "faixa": {
      "type": "array",
      "description": "3 diferenciais objetivos sob o hero. Fato, não adjetivo.",
      "items": { "type": "object", "properties": { "titulo": { "type": "string" }, "texto": { "type": "string" } } }
    },
    "estrutura": { "type": "array", "items": { "type": "string" } },
    "convenios": { "type": "array", "items": { "type": "string" } },
    "pagamento": {
      "type": "object",
      "properties": {
        "particular": { "type": "boolean", "default": true },
        "observacao": { "type": "string", "description": "formas de pagamento; não coloque valores" }
      }
    },
    "endereco": {
      "type": "object",
      "properties": {
        "logradouro": { "type": "string" },
        "complemento": { "type": "string" },
        "bairro": { "type": "string" },
        "cidade": { "type": "string" },
        "uf": { "type": "string", "maxLength": 2 },
        "cep": { "type": "string" },
        "referencia": { "type": "string", "description": "ponto de referência; é o que o paciente realmente usa" },
        "estacionamento": { "type": "string" },
        "acessibilidade": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "mapsUrl": { "type": "string" },
        "mapsEmbed": { "type": "string", "description": "URL de embed do Maps; sem ela a seção sai sem o mapa" }
      }
    },
    "horarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dias": { "type": "string", "examples": ["Segunda a sexta", "Sábado"] },
          "horario": { "type": "string", "examples": ["08h às 19h"] }
        }
      }
    },
    "contato": {
      "type": "object",
      "required": ["whatsapp"],
      "properties": {
        "whatsapp": { "type": "string", "description": "com 55 e DDD, só dígitos: 5511999998888" },
        "mensagemWhatsapp": { "type": "string", "description": "mensagem que já vem escrita ao abrir a conversa" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "instagram": { "type": "string", "description": "sem @" }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pergunta": { "type": "string" },
          "resposta": { "type": "string" },
          "aberta": { "type": "boolean" }
        }
      }
    },
    "textos": {
      "type": "object",
      "description": "sobrescreve os títulos de seção; tudo tem padrão",
      "properties": {
        "tituloServicos": { "type": "string" }, "leadServicos": { "type": "string" },
        "tituloEquipe": { "type": "string" }, "leadEquipe": { "type": "string" },
        "tituloEstrutura": { "type": "string" }, "leadEstrutura": { "type": "string" },
        "tituloLocal": { "type": "string" }, "tituloFaq": { "type": "string" },
        "tituloCta": { "type": "string" }, "leadCta": { "type": "string" }
      }
    },
    "marca": {
      "type": "object",
      "properties": {
        "corPrincipal": { "type": "string", "default": "#12626e", "description": "as variantes são calculadas a partir dela" },
        "corDestaque": { "type": "string", "default": "#d99b3f" },
        "fonteTitulo": { "type": "string", "default": "Newsreader", "description": "nome exato no Google Fonts" },
        "fonteTexto": { "type": "string", "default": "Inter" },
        "sigla": { "type": "string", "description": "2 letras do logo; derivada do nome se ausente" }
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "imagem": { "type": "string", "description": "og:image" },
        "imagemHero": { "type": "string", "description": "foto de fundo do hero, aplicada com transparência" }
      }
    },
    "politicaPrivacidade": { "type": "boolean" },
    "depoimentos": {
      "type": "array",
      "description": "SÓ com conselho NENHUM. Sob qualquer conselho de saúde o validador reprova — ver COMPLIANCE.md.",
      "items": { "type": "object", "properties": { "nome": { "type": "string" }, "texto": { "type": "string" } } }
    },
    "formulario": { "type": "object", "description": "não recomendado: coleta dado sensível de saúde (LGPD art. 11)" }
  },
  "definitions": {
    "profissional": {
      "type": "object",
      "required": ["nome"],
      "properties": {
        "nome": { "type": "string" },
        "registro": { "type": "string", "examples": ["CRM-SP 123456", "CRO-RJ 45678", "CRP 06/123456"] },
        "rqe": { "type": "string", "description": "obrigatório junto do CRM quando anuncia especialidade médica" },
        "especialidade": { "type": "string" },
        "atuacao": { "type": "string", "description": "use quando não há RQE: descreve a atuação sem chamar de especialidade" },
        "formacao": { "type": "array", "items": { "type": "string" } },
        "foto": { "type": "string" }
      }
    }
  }
}
