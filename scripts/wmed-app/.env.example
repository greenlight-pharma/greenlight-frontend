# Server only. Never prefix secrets with VITE_.
# Contas WMed (Postgres no Railway). Rode `npm run migrate` após configurar.
DATABASE_URL=
DATABASE_POOL_MAX=3
# Chat WMed (API da Claude). Modelo padrão: claude-opus-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Perguntas por dia: plano gratuito e teto antiabuso do plano Pro ("ilimitado").
WMED_FREE_DAILY_CHATS=10
WMED_PRO_DAILY_CHATS=300
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
WMED_API_PORT=5199
# Testes de banco: WMED_TEST_DATABASE_URL=postgres://… npm test
