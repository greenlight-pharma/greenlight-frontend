diff --git a/scripts/wmed-app/tests/page-exit.test.mjs b/scripts/wmed-app/tests/page-exit.test.mjs
new file mode 100644
index 0000000..12a4755
--- /dev/null
+++ b/scripts/wmed-app/tests/page-exit.test.mjs
@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { protectPageExit } from '../shared/page-exit.mjs';
+
+test('exit protection cancels unload only while registered and cleans up', () => {
+  const target = new EventTarget();
+  const exit = () => new Event('beforeunload', {cancelable:true});
+  assert.equal(target.dispatchEvent(exit()), true);
+  const release = protectPageExit(target);
+  const pending = exit();
+  assert.equal(target.dispatchEvent(pending), false);
+  assert.equal(pending.defaultPrevented, true);
+  release();
+  assert.equal(target.dispatchEvent(exit()), true);
+  release();
+  assert.equal(target.dispatchEvent(exit()), true);
+});
+
+test('cleanup preserves independent history protection and internal navigation', () => {
+  const target = new EventTarget();
+  const history = e => e.preventDefault();
+  target.addEventListener('beforeunload', history);
+  const release = protectPageExit(target);
+  assert.equal(target.dispatchEvent(new Event('hashchange', {cancelable:true})), true);
+  release();
+  assert.equal(target.dispatchEvent(new Event('beforeunload', {cancelable:true})), false);
+  target.removeEventListener('beforeunload', history);
+  assert.equal(target.dispatchEvent(new Event('beforeunload', {cancelable:true})), true);
+});
