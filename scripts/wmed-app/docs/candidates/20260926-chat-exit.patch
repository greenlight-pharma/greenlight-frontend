+++ b/scripts/wmed-app/shared/page-exit.mjs
@@ -0,0 +1,10 @@
+// Use only while work is pending. This does not save or transmit any content.
+// Mobile OS termination can bypass beforeunload entirely.
+export function protectPageExit(target) {
+  const warn = event => {
+    event.preventDefault();
+    event.returnValue = true;
+  };
+  target.addEventListener('beforeunload', warn);
+  return () => target.removeEventListener('beforeunload', warn);
+}
